-- MAIN LOOP
RunService.RenderStepped:Connect(function()
    colorIndex = colorIndex % #rainbowColors + 1

    -- SPAM
    if SpamActive and ManualSpam then
        local now = tick()
        if now - lastSpamTick >= SPAM_INTERVAL then
            lastSpamTick = now; DoParry()
        end
    end

    -- TRAIL
    for _, v in pairs(workspace:GetChildren()) do
        if v:IsA("BasePart") and (v.Name:lower():find("ball") or v:GetAttribute("Ball")) then
            if trailEnabled then
                local color = selectedTrailColor == "Rainbow" and rainbowColors[colorIndex] or colorOptions[selectedTrailColor]
                addTrail(v, color)
                if selectedTrailColor == "Rainbow" then
                    local t = v:FindFirstChild("KittyTrail")
                    if t then t.Color = ColorSequence.new(rainbowColors[colorIndex]) end
                end
            else removeTrail(v) end
        end
    end

    -- ESP
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local head = p.Character:FindFirstChild("Head")
            if head then
                local bb = head:FindFirstChild("KittyESP")
                if espEnabled then
                    if not bb then
                        local billboard = Instance.new("BillboardGui", head)
                        billboard.Name = "KittyESP"; billboard.Size = UDim2.new(0, 200, 0, 50)
                        billboard.AlwaysOnTop = true; billboard.ExtentsOffset = Vector3.new(0, 3, 0)
                        local label = Instance.new("TextLabel", billboard)
                        label.Size = UDim2.new(1, 0, 1, 0); label.BackgroundTransparency = 1
                        label.Text = p.DisplayName; label.TextColor3 = Color3.fromRGB(255, 105, 180)
                        label.Font = Enum.Font.GothamBold; label.TextSize = 18
                        label.TextStrokeTransparency = 0; label.TextStrokeColor3 = Color3.new(0, 0, 0)
                    end
                else if bb then bb:Destroy() end end
            end
        end
    end

    -- AUTO JUMP
    if autoJumpEnabled and not hasJumped then
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.FloorMaterial ~= Enum.Material.Air then
                hum.Jump = true
                hasJumped = true
                task.delay(1, function() hasJumped = false end)
            end
        end
    end

    -- ORBIT
    if orbitEnabled then
        orbitAngle = orbitAngle + 0.05
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            if #orbitParts == 0 then setupOrbit() end
            local radius = 4
            local positions = {
                Vector3.new(math.cos(orbitAngle) * radius, 0, math.sin(orbitAngle) * radius),
                Vector3.new(math.cos(orbitAngle + math.pi) * radius, 0, math.sin(orbitAngle + math.pi) * radius),
                Vector3.new(0, math.sin(orbitAngle) * radius, math.cos(orbitAngle) * radius),
                Vector3.new(0, math.cos(orbitAngle) * radius, math.sin(orbitAngle + math.pi/2) * radius),
            }
            for i, part in pairs(orbitParts) do
                if part and part.Parent then
                    part.CFrame = CFrame.new(hrp.Position + positions[i])
                end
            end
        end
    else
        if #orbitParts > 0 then
            for _, v in pairs(orbitParts) do pcall(function() v:Destroy() end) end
            orbitParts = {}
        end
    end

    -- IMMORTAL
    if immortalEnabled then
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.MaxHealth = math.huge
                if hum.Health < math.huge then hum.Health = math.huge end
            end
        end
    end
end)

-- AUTO PARRY
RunService.PreSimulation:Connect(function()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp or not AutoParry then return end
    local ball = nil
    for _, v in pairs(workspace:GetChildren()) do
        if v:IsA("BasePart") and v.AssemblyLinearVelocity.Magnitude > 10 and (v.Name:lower():find("ball") or v:GetAttribute("Ball")) then
            ball = v; break
        end
    end
    if ball then
        local vel = ball.AssemblyLinearVelocity.Magnitude
        VLog.Text = math.floor(vel)..".0"
        if vel > peakVel then peakVel = vel; PLog.Text = math.floor(peakVel)..".0" end
        local target = ball:GetAttribute("target") or ball:GetAttribute("Target")
        if target ~= LocalPlayer.Name or tick() - lastHitTick < 0.45 then return end
        local range = math.clamp(10 + (vel * 0.18), 11, 120)
        if (hrp.Position - ball.Position).Magnitude < range then
            local toPlayer = (hrp.Position - ball.Position).Unit
            local ballDir = ball.AssemblyLinearVelocity.Unit
            local dot = toPlayer:Dot(ballDir)
            if dot < 0.15 then return end
            lastHitTick = tick()
            local waitTime
            if vel >= 500 then
                waitTime = 0.01
            elseif vel >= 250 then
                waitTime = 0.015
            elseif vel >= 100 then
                waitTime = 0.02
            else
                waitTime = 0.025
            end
            task.wait(waitTime)
            if hitSoundEnabled then playHitSound(80) end
            local cam = workspace.CurrentCamera; local oldCF = cam.CFrame; local x, y, z = 0, 0, 0
            if CurrentMode == "Random" then x, y, z = math.random(-360,360), math.random(-360,360), math.random(-360,360)
            elseif CurrentMode == "Up" then x = -90
            elseif CurrentMode == "Side" then y = math.random(1,2) == 1 and 90 or -90
            elseif CurrentMode == "Backward" then x = 180 end
            if CurrentMode ~= "Camera" and CurrentMode ~= "None" and (x ~= 0 or y ~= 0 or z ~= 0) then
                cam.CFrame = oldCF * CFrame.Angles(math.rad(x), math.rad(y), math.rad(z))
                DoParry()
                task.delay(0.12, function() cam.CFrame = oldCF end)
            else DoParry() end
        end
    else VLog.Text = "0.0" end
end)
